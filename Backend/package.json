    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.2",
    "multer": "^2.4.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22.3.0"
  }
